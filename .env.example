# TOSS Environment Configuration Template
# Copy to .env and configure as needed. NEVER commit your actual API keys.

# Gemini API configuration (optional for AI structuring)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# TOSS Receiver Configuration
TOSS_RECEIVER_PORT=7443
TOSS_RECEIVER_HOST=0.0.0.0
TOSS_STORAGE_DIR=./received
TOSS_PAIRING_SECRET=toss-dev-secret-change-in-production

# AI Proxy Service Configuration (optional server-side proxy)
AI_PROXY_PORT=8080
